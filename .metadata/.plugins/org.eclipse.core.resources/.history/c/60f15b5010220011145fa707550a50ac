void StartLCDTask(void *argument)
{
  /* USER CODE BEGIN StartLCDTask */
  /* Infinite loop */
	LCD_Init();
		LCD_SetCursor(0,0);
		LCD_Print("password:       ");

		for(;;){
			osSemaphoreAcquire(LCDSem, 10000u);

			//flush lcd
			LCD_SetCursor(0,0);
			LCD_Print("                ");

			char toDisplay[20];
			memset(toDisplay,  ' ', sizeof(toDisplay) - 1);
			toDisplay[19]='\0';

			if(armed==1){
				strcpy(toDisplay, "ARME: ");
			} else if(setPass==1) {strcpy(toDisplay, "NON ARME: ");
			} else {
				strcpy(toDisplay, "password: ");
			}

			strcat(toDisplay, passToDisplay);

			LCD_SetCursor(0,0);
			LCD_Print(toDisplay);


		}
  /* USER CODE END StartLCDTask */
}


void StartKeypadTask(void *argument)
{
	IOEXP_WriteLEDs(0xff);
		passToDisplay[6]='\0';
		passHidden[6]='\0';
		passAttempt[6]='\0';
		MPR121_Init();
	  /* USER CODE BEGIN 5 */
	  /* Infinite loop */

		for(;;){
			char input = GetKey();
			switch (input){
				case 0: osDelay(10); continue;break;
				case 'S': break;
				case 'N':
					if(setPass==0&&(passHeadD==3||passHeadD==5)){
						for (int i=0;i<=passHeadD;i++){
							passHidden[i]=passToDisplay[i];
						}
						armed=1;
						passHeadH=passHeadD;
						setPass=1;
						IOEXP_WriteLEDs(0xef);
					} else if (setPass&&strcmp(passAttempt, passHidden)==0){
						//they are the same
						//flip armed
						if(armed==1){armed=0;IOEXP_WriteLEDs(0xfe);
						}
						else {armed=1;IOEXP_WriteLEDs(0xef);
						}

					} else if(armed) {
						osSemaphoreRelease(AlarmSem);
					}
					memset(passAttempt, '\0', sizeof(passAttempt));
					passHeadA=-1;
					memset(passToDisplay, '\0', sizeof(passToDisplay));
					passHeadD=-1;
					osSemaphoreRelease(LCDSem);
					break;
				default:
					if(setPass==0){
						if(passHeadD>=5){break;}
						passHeadD++;passToDisplay[passHeadD]=input;
						osSemaphoreRelease(LCDSem);
					} else {
						if(passHeadA>=5||passHeadD>=5){break;}
						passHeadA++;passAttempt[passHeadA]=input;
						passHeadD++;passToDisplay[passHeadD]='*';
						osSemaphoreRelease(LCDSem);
					}
					break;

			}
			osDelay(300);
		}

  /* USER CODE END StartKeypadTask */
}


